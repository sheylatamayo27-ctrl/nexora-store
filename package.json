{
  "name": "nexora-store",
  "version": "0.1.0",
  "private": true,
  "description": "Nexora — tienda de electrónica. Frontend en Next.js fiel al diseño de Figma.",
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/generate-assets-manifest.mjs",
    "build": "next build",
    "prebuild": "node scripts/generate-assets-manifest.mjs",
    "start": "next start",
    "lint": "next lint",
    "test:visual": "playwright test",
    "test:visual:desktop": "playwright test --project=desktop-1440 --project=desktop-1024",
    "test:visual:mobile": "playwright test --project=mobile-390 --project=mobile-360 --project=tablet-834 --project=tablet-768",
    "test:visual:update-desktop": "playwright test --project=desktop-1440 --project=desktop-1024 --update-snapshots"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.454.0",
    "next": "14.2.33",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.16.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.33",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
