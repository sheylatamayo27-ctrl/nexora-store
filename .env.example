# Copia este archivo a .env.local y rellena los valores.

# URL base de la API a la que pide el cliente (SWR: búsqueda y listado de
# categoría). Vacío = valor por defecto de src/server/config.ts ("/api", la API
# simulada de src/app/api, que lee del catálogo local en src/server/db).
NEXT_PUBLIC_API_BASE_URL=

# Latencia simulada de los endpoints /api, en ms (0–10000).
# Vacío = 250 en desarrollo y 0 en producción.
NEXT_PUBLIC_API_FAKE_LATENCY=
